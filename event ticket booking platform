                </div>
            `);
            document.getElementById("bookingBox").style.display = "none";
        }
    };
    let rzp = new Razorpay(options);
    rzp.open();
}

function saveBookingToLocalStorage(){
    // Save to the movie-specific record
    let key = "bookings_" + selectedItem.name;
    let existingBookings = JSON.parse(localStorage.getItem(key)) || [];
    let updatedBookings = [...existingBookings, ...selectedSeats];
    localStorage.setItem(key, JSON.stringify(updatedBookings));
}

// Auth Systems
function openLogin(){ 
    isSignup = false;
    document.getElementById("authTitle").innerText = "Login";
    document.getElementById("loginModal").style.display = "flex"; 
}
function toggleAuth(){
    isSignup = !isSignup;
    document.getElementById("authTitle").innerText = isSignup ? "Signup" : "Login";
}
function closeAll(){ document.getElementById("loginModal").style.display = "none"; }

function handleAuth(){
    let u = document.getElementById("luser").value;
    let p = document.getElementById("lpass").value;
    if(!u || !p) return;

    if(isSignup){
        if(localStorage.getItem("user_"+u)){ alert("User already exists"); return; }
        localStorage.setItem("user_"+u, p);
        alert("Signup successful! Please login.");
        toggleAuth();
    } else {
        if(localStorage.getItem("user_"+u) === p){
            user = u;
            localStorage.setItem("activeUser", u);
            updateUserUI();
            closeAll();
        } else {
            alert("Invalid credentials");
        }
    }
}

function logout(){
    localStorage.removeItem("activeUser");
    user = null;
    updateUserUI();
    document.getElementById("bookingBox").style.display = "none";
}

function updateUserUI(){
    document.getElementById("userDisplay").innerText = user ? "Welcome, " + user : "";
    document.getElementById("loginBtn").style.display = user ? "none" : "inline-block";
    document.getElementById("logoutBtn").style.display = user ? "inline-block" : "none";
}

window.onload = init;
</script>
</body>
