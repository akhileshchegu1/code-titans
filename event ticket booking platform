<img src="https://images.unsplash.com/photo-1517649763962-0c623066013b">
<h3>Cycle race</h3>
<button onclick="selectItem('cycle race',250)">Book</button>
</div>

</div>
</div>

<!-- BOOKING -->
<div id="booking" class="hidden">
<h2 id="selectedTitle"></h2>

<div id="seatContainer"></div>

<h3>Total Seats: <span id="seatCount">0</span></h3>
<h3>Total Amount: ₹<span id="totalAmount">0</span></h3>

<button onclick="payNow()">💳 Pay & Book</button>
<button onclick="goHome()">⬅ Back</button>

<div id="qrCode"></div>
</div>

</div>

<script>
let selectedMovie = "";
let price = 0;
let selectedSeats = [];
let bookedSeats = [];

/* AUTH SYSTEM (localStorage) */
function signupUserFunc(){
  let user = document.getElementById("signupUser").value;
  let pass = document.getElementById("signupPass").value;

  if(user === "" || pass === ""){
    alert("Fill all fields");
    return;
  }

  localStorage.setItem(user, pass);
  alert("Signup successful!");
  backToLogin();
}

function loginUserFunc(){
  let user = document.getElementById("loginUser").value;
  let pass = document.getElementById("loginPass").value;

  if(localStorage.getItem(user) === pass){
    document.getElementById("login").style.display="none";
    document.getElementById("home").style.display="block";
  }else{
    alert("Invalid credentials");
  }
}

function showSignup(){
  document.getElementById("login").style.display="none";
  document.getElementById("signup").style.display="block";
}

function backToLogin(){
  document.getElementById("signup").style.display="none";
  document.getElementById("login").style.display="block";
}

/* SEARCH */
function searchItems(){
  let input=document.getElementById("searchBar").value.toLowerCase();
  let cards=document.getElementsByClassName("card");

  for(let i=0;i<cards.length;i++){
    let title=cards[i].innerText.toLowerCase();
    cards[i].style.display = title.includes(input) ? "inline-block":"none";
  }
}

/* SELECT */
function selectItem(name,p){
  selectedMovie=name;
  price=p;
  selectedSeats=[];
  document.getElementById("home").style.display="none";
  document.getElementById("booking").style.display="block";
  document.getElementById("selectedTitle").innerText=name;
  generateSeats();
}

/* SEATS */
function generateSeats(){
  let container=document.getElementById('seatContainer');
  container.innerHTML="";

  for(let i=1;i<=30;i++){
    let seat=document.createElement('div');
    seat.classList.add('seat');

    if(bookedSeats.includes(i)){
      seat.classList.add('booked');
    }

    seat.innerText=i;

    seat.onclick=function(){
      if(seat.classList.contains('booked')) return;

      if(seat.classList.contains('selected')){
        seat.classList.remove('selected');
        selectedSeats=selectedSeats.filter(s=>s!=i);
      }else{
        seat.classList.add('selected');
        selectedSeats.push(i);
      }
      updateTotal();
    };

    container.appendChild(seat);
  }
}

/* TOTAL */
function updateTotal(){
  document.getElementById("seatCount").innerText=selectedSeats.length;
  document.getElementById("totalAmount").innerText=selectedSeats.length*price;
}

/* PAYMENT */
function payNow(){

  if(selectedSeats.length === 0){
    alert("Select at least 1 seat");
    return;
  }

  let total = selectedSeats.length * price;

  var options = {
    "key": "rzp_test_SlwhoAsYivcaVQ",
    "amount": total * 100,
    "currency": "INR",
    "name": "BookWave",
    "description": selectedMovie,

    "handler": function (response){
      bookedSeats.push(...selectedSeats);

      let qrData = `Movie: ${selectedMovie}
Seats: ${selectedSeats.join(",")}
Total: ₹${total}
PaymentID: ${response.razorpay_payment_id}`;

      document.getElementById('qrCode').innerHTML="";
      new QRCode(document.getElementById("qrCode"), qrData);

      alert("✅ Payment Successful!");
      generateSeats();
    },

    "theme": {"color":"#3399cc"}
  };

  var rzp = new Razorpay(options);
  rzp.open();
}

/* BACK */
function goHome(){
  document.getElementById("booking").style.display="none";
  document.getElementById("home").style.display="block";
}
</script>

</body>
</html>
