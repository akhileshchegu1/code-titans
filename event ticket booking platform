<body>

<header>
    <h2>🎟️ BookWave</h2>
    <div>
        <span id="userDisplay" style="margin-right: 15px;"></span>
        <button id="loginBtn" class="primary" onclick="openLogin()">Login</button>
        <button id="logoutBtn" style="display:none" onclick="logout()">Logout</button>
    </div>
</header>

<div class="search-bar">
    <input id="search" placeholder="Search movies or events..." onkeyup="searchAll()">
</div>

<div class="filter">
    <button onclick="filterType('all')">All</button>
    <button onclick="filterType('movie')">Movies</button>
    <button onclick="filterType('event')">Events</button>
</div>

<div class="container" id="list"></div>

<div class="booking" id="bookingBox">
    <div class="booking-content">
        <button onclick="document.getElementById('bookingBox').style.display='none'">← Back</button>
        <h2 id="name" style="text-align:center"></h2>
        <div class="screen">SCREEN</div>
        <div class="seats" id="seatContainer"></div>
        <div class="total-box">Total Payable: <strong>₹<span id="total">0</span></strong></div>
        <button class="primary" style="width:100%; padding: 15px;" onclick="pay()">Confirm & Pay</button>
    </div>
</div>

<div class="modal" id="loginModal">
    <div class="modal-box">
        <h3 id="authTitle">Login</h3>
        <div class="pass-wrapper"><input id="luser" placeholder="Username"></div>
        <div class="pass-wrapper">
            <input id="lpass" type="password" placeholder="Password">
            <button class="toggle-btn" onclick="togglePassword()">Show</button>
        </div>
        <button class="primary" style="width:100%; margin-top: 10px;" onclick="handleAuth()">Submit</button>
        <p style="text-align:center; cursor:pointer; color:blue; font-size: 14px;" onclick="toggleAuth()">New user? Signup</p>
        <button onclick="closeAll()" style="width:100%; margin-top:5px">Cancel</button>
    </div>
</div>

<script>
let allItems=[], filtered=[];
let selectedItem=null, selectedSeats=[];
let isSignup = false;
let user = localStorage.getItem("activeUser");

let events=[
    {name:"Arijit Singh Live",price:1500,type:"event",image:"https://cf-img-a-in.tosshub.com/sites/visualstory/wp/2025/04/HD-wallpaper-arjith-singh-bollywood-singerITG-1745563735262.jpg?size=*:900"},
    {name:"Standup Comedy",price:499,type:"event",image:"data:image/jpeg;base64,"}
];

let movies=[
    {name:"Avengers: Endgame",price:250,type:"movie",image:"https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRnXEwQlva93WuBdWDK6LlOSf4f96CB5OxToqcdkHiWBnn2p5WOjaOGKo_t6i9F-gQ2tYUp&s=10"},
    {name:"Interstellar",price:300,type:"movie",image:"https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSngBJ0B7UDrLUkDlp6DCQLsEYuWR-DiHwbnxFFCniB3HiP3f3NZmR1-lKSC34ge6YXu4LX&s=10"}
];

function init(){
    allItems = [...movies, ...events];
    filtered = allItems;
    display();
    updateUserUI();
}

function togglePassword() {
    let pass = document.getElementById("lpass");
    let btn = event.target;
    pass.type = (pass.type === "password") ? "text" : "password";
    btn.innerText = (pass.type === "password") ? "Show" : "Hide";
}

function display(){
    let list = document.getElementById("list");
    list.innerHTML="";
    filtered.forEach((item, idx)=>{
        list.innerHTML += `
            <div class="card">
                <img src="${item.image}">
                <div class="card-content">
                    <small>${item.type.toUpperCase()}</small>
                    <h3>${item.name}</h3>
                    <p>Starts from ₹${item.price}</p>
                    <button class="primary" onclick="openBooking(${idx})">Book Tickets</button>
                </div>
            </div>`;
    });
}

function searchAll(){
    let q = document.getElementById("search").value.toLowerCase();
    filtered = allItems.filter(i => i.name.toLowerCase().includes(q));
    display();
}

function filterType(t){
    filtered = (t === "all") ? allItems : allItems.filter(i => i.type === t);
    display();
}

function openBooking(idx){
    if(!user){ alert("Please login to book tickets"); openLogin(); return; }
    selectedItem = filtered[idx];
    selectedSeats = [];
    document.getElementById("name").innerText = selectedItem.name;
    document.getElementById("bookingBox").style.display = "block";
    renderSeats();
}

function renderSeats(){
    const container = document.getElementById("seatContainer");
    container.innerHTML = "";
    updateTotal();

    let booked = JSON.parse(localStorage.getItem("booked_" + selectedItem.name)) || [];
    let rows = ["A", "B", "C", "D", "E"];
    
    rows.forEach(row => {
        for(let i=1; i<=11; i++){
            if(i === 6){ // Create Aisle
                let gap = document.createElement("div");
                gap.className = "aisle";
                container.appendChild(gap);
                continue;
            }
            let id = row + i;
            let seat = document.createElement("div");
            seat.className = booked.includes(id) ? "seat booked" : "seat";
            seat.innerText = id;
            if(!booked.includes(id)){
                seat.onclick = () => {
                    if(selectedSeats.includes(id)){
                        selectedSeats = selectedSeats.filter(s => s !== id);
                        seat.classList.remove("selected");
                    } else {
                        if(selectedSeats.length >= 6) return alert("Max 6 seats!");
                        selectedSeats.push(id);
                        seat.classList.add("selected");
                    }
                    updateTotal();
                };
            }
            container.appendChild(seat);
        }
    });
}

function updateTotal(){
    let total = 0;
    selectedSeats.forEach(s => {
        let mult = (s[0] === "A" || s[0] === "B") ? 1.5 : 1;
        total += selectedItem.price * mult;
    });
    document.getElementById("total").innerText = Math.floor(total);
}

function pay(){
    if(selectedSeats.length === 0) return alert("Select seats!");
    let amt = document.getElementById("total").innerText;

    let options = {
        key: "rzp_test_SlwhoAsYivcaVQ", // Replace with your key
        amount: amt * 100,
        currency: "INR",
        name: "BookWave",
        handler: function(res){
            let key = "booked_" + selectedItem.name;
            let current = JSON.parse(localStorage.getItem(key)) || [];
            localStorage.setItem(key, JSON.stringify([...current, ...selectedSeats]));
            alert("Booking Confirmed!");
            location.reload();
        }
    };
    new Razorpay(options).open();
}

function openLogin(){ 
    isSignup = false; 
    document.getElementById("authTitle").innerText = "Login";
    document.getElementById("loginModal").style.display = "flex"; 
}
function toggleAuth(){
    isSignup = !isSignup;
    document.getElementById("authTitle").innerText = isSignup ? "Signup" : "Login";
}
function closeAll(){ document.getElementById("loginModal").style.display = "none"; }

function handleAuth(){
    let u = document.getElementById("luser").value;
    let p = document.getElementById("lpass").value;
    if(!u || !p) return alert("Fill all fields");

    if(isSignup){
        localStorage.setItem("user_"+u, p);
        alert("Account Created! Please Login.");
        toggleAuth();
    } else {
        if(localStorage.getItem("user_"+u) === p){
            user = u;
            localStorage.setItem("activeUser", u);
            updateUserUI();
            closeAll();
        } else alert("Wrong credentials");
    }
}

function logout(){
    localStorage.removeItem("activeUser");
    user = null;
    updateUserUI();
}

function updateUserUI(){
    document.getElementById("userDisplay").innerText = user ? "Hi, " + user : "";
    document.getElementById("loginBtn").style.display = user ? "none" : "inline-block";
    document.getElementById("logoutBtn").style.display = user ? "inline-block" : "none";
}

window.onload = init;
</script>
</body>
</html>
