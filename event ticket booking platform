<div class="card">
<img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRFooTK0pKfgo9L_NE87BVeR8MEPqe1OnEYpg&s">
<h3>Interstellar</h3>
<button onclick="selectItem('Interstellar',130)">Book</button>
</div>

<div class="card">
<img src="https://www.suitmeister.com/cdn/shop/files/OBBO-0012_The-Joker_studio_wb_01.jpg?v=1732871577">
<h3>Joker</h3>
<button onclick="selectItem('Joker',140)">Book</button>
</div>

